# Base project needs no API keys. Set keys only for separately enabled paid services.
# ElevenLabs (docs/ELEVENLABS.md). Ключ вписуй лише в .env, не сюди.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Необов'язково, 0..1 (speed 0.7..1.2). Порожньо = налаштування голосу з акаунта ElevenLabs.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
