{
  "name": "devguide-video-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Remotion lab: runnable DevGuide starters and AI production prompts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "remotion studio src/index.ts",
    "check": "tsc --noEmit && node scripts/doctor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:skills": "node scripts/install-skills.mjs",
    "setup:extras": "node scripts/install-extras.mjs",
    "render": "node scripts/render.mjs",
    "render:all": "node scripts/render.mjs --all",
    "render:preview": "node scripts/render.mjs Motion --draft",
    "render:3d": "node scripts/render.mjs Three",
    "render:gsap": "node scripts/render.mjs Motion",
    "render:svg": "node scripts/render.mjs Vector",
    "render:captions": "node scripts/render.mjs Captions",
    "render:hybrid": "node scripts/render.mjs Hybrid",
    "qa:frames": "node scripts/qa-frames.mjs",
    "preview:final": "node scripts/render-timed.mjs draft DevGuide-Final",
    "render:final": "node scripts/render-timed.mjs final DevGuide-Final && node scripts/master-audio.mjs out/final/devguide-final-1080x1920.mp4",
    "preview:alts": "node scripts/render-timed.mjs draft DevGuide-A-Kinetic DevGuide-B-Depth DevGuide-C-Explainer",
    "render:alts": "node scripts/render-timed.mjs final DevGuide-A-Kinetic DevGuide-B-Depth DevGuide-C-Explainer",
    "qa:final": "node scripts/qa-frames.mjs DevGuide-Final",
    "qa:sheet": "node scripts/qa-sheet.mjs",
    "tts": "node scripts/tts.mjs",
    "out:index": "node scripts/out-index.mjs",
    "render:skia": "npx remotion render src/skia/index.ts DevGuide-Skia-Lab out/skia-lab/devguide-skia-lab-1080x1920.mp4 --config=remotion.skia.config.ts --codec=h264 --crf=18 --concurrency=4",
    "render:day5": "npx remotion render src/index.ts DevGuide-Day5-Epic 5/epic/day5-epic-1080x1920.mp4 --codec=h264 --crf=18 --concurrency=4 && node scripts/master-audio.mjs 5/epic/day5-epic-1080x1920.mp4"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@react-three/fiber": "9.3.0",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/gsap": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/lottie": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/skia": "4.0.534",
    "@remotion/tailwind-v4": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@shopify/react-native-skia": "2.0.0",
    "culori": "4.0.2",
    "gsap": "3.13.0",
    "lottie-web": "5.13.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "remotion-bits": "0.2.1",
    "tailwindcss": "4.1.13",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.2"
  }
}
